{{!
    @template local_contentfreshness/report

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="local-contentfreshness-report">
    <p>{{intro}}</p>
    <div class="mb-3">{{{runbutton}}}</div>
    <div class="mb-3">{{{filterform}}}</div>
    <p class="text-muted">{{summary}}</p>

    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                <tr>
                    <th scope="col">{{stritem}}</th>
                    <th scope="col">{{strsnippet}}</th>
                    <th scope="col">{{strreason}}</th>
                    <th scope="col">{{strrisktype}}</th>
                    <th scope="col">{{strseverity}}</th>
                    <th scope="col">{{strclassification}}</th>
                    <th scope="col">{{strmodified}}</th>
                    <th scope="col">{{straction}}</th>
                </tr>
                </thead>
                <tbody>
                {{#rows}}
                    <tr>
                        <td>
                            <strong>{{{itemname}}}</strong>
                            <div class="small text-muted">{{typename}} · {{{sectionlabel}}}</div>
                            {{#cachedlabel}}<span class="badge bg-secondary">{{cachedlabel}}</span>{{/cachedlabel}}
                        </td>
                        <td class="local-contentfreshness-snippet">{{snippet}}</td>
                        <td>{{reason}}</td>
                        <td>{{risklabel}}</td>
                        <td><span class="badge bg-light text-dark">{{severitylabel}}</span></td>
                        <td>{{classificationlabel}}</td>
                        <td>{{modifiedlabel}}</td>
                        <td><a class="btn btn-sm btn-outline-secondary" href="{{{editurl}}}">{{stredit}}</a></td>
                    </tr>
                {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}

    {{^hasrows}}
        <div class="alert alert-info">{{noresults}}</div>
    {{/hasrows}}
</div>
